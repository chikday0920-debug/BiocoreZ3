rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Historial de analisis (Fase 7). Solo el backend (Admin SDK,
    // que no pasa por estas reglas) escribe documentos; el cliente
    // solo puede leer los suyos, y nunca modificarlos o borrarlos -
    // el historial es un registro, no algo editable.
    match /analisis/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Denegado por defecto para cualquier otra coleccion futura.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
